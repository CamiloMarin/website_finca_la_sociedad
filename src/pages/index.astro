---
// Finca la Sociedad - Landing Page
import "../styles/global.css";

// Layaot
import Layout from "../layaout/Layaout.astro";
const whatsappNumber = "573001234567"; // Reemplaza con tu número real
const whatsappMessage = "Hola, me interesa reservar la Finca la Sociedad";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<Layout title="Finca la Sociedad - Alquiler de Finca en Antioquia, Colombia">
  <!-- Main Menu Section -->

  <!-- <header>
    <div
      class="master-header max-w-7xl mx-auto px-4 flex justify-between items-center"
    >
      <div class="logo-main">
        
        <img
          src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=64&q=80"
          alt="Finca la Sociedad Logo"
          class="w-10 h-10 rounded-full object-cover"
        />
      </div>

      <nav class="top-0 left-0 right-0 z-5">
        <ul class="menu-block flex space-x-6 p-4 max-w-7xl mx-auto">
          <li>
            <a
              href="#services"
              class="text-gray-700 hover:text-green-600 font-medium"
              >Servicios</a
            >
          </li>
          <li>
            <a
              href="#gallery"
              class="text-gray-700 hover:text-green-600 font-medium">Galería</a
            >
          </li>
          <li>
            <a
              href="#contact"
              class="text-gray-700 hover:text-green-600 font-medium">Contacto</a
            >
          </li>
        </ul>
      </nav>
    </div>
  </header> -->

  <header class="fixed top-4 left-1/2 -translate-x-1/2 z-50">
    <div
      class="flex items-center justify-between gap-10
           px-6 py-3
           bg-[#0b1220]/80 backdrop-blur-md
           border border-white/10
           rounded-full"
    >
      <!-- Logo -->
      <div class="flex items-center gap-2">
        <img
          src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=64&q=80"
          alt="Logo"
          class="w-8 h-8 rounded-full"
        />
      </div>

      <!-- Menu -->
      <nav>
        <ul class="flex items-center gap-6">
          <li>
            <a href="#services" class="nav-link">Docs</a>
          </li>
          <li>
            <a href="#gallery" class="nav-link">Resources</a>
          </li>
          <li>
            <a href="#contact" class="nav-link">Premium</a>
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section
    class="relative h-screen flex items-center justify-center overflow-hidden"
  >
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1920&q=80"
        alt="Finca la Sociedad"
        class="w-full h-full object-cover"
      />
      <div class="hero-gradient absolute inset-0"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 text-center text-white px-4 max-w-4xl mx-auto">
      <h1 class="text-5xl md:text-7xl font-bold mb-6 drop-shadow-lg">
        Finca la Sociedad
      </h1>
      <p class="text-2xl md:text-3xl mb-8 font-light">
        Alquiler de finca campestre para descanso y eventos
      </p>
      <div class="space-y-4 mb-10">
        <p class="text-xl md:text-2xl flex items-center justify-center gap-2">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
              clip-rule="evenodd"></path>
          </svg>
          Antioquia, Colombia
        </p>
        <p class="text-xl md:text-2xl flex items-center justify-center gap-2">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
            <path
              d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"
            ></path>
          </svg>
          Hasta 15 personas
        </p>
      </div>
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-green-600 px-10 py-4 rounded-full text-xl font-semibold hover:bg-green-50 transition-all transform hover:scale-105 shadow-2xl"
      >
        📱 Reservar por WhatsApp
      </a>
    </div>

    <!-- Scroll Indicator -->
    <div
      class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce"
    >
      <svg
        class="w-8 h-8 text-white"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- ¿Qué ofrece? Section -->
  <section
    class="py-24 bg-white flex flex-row justify-self-center centered px-4 md:px-0 w-full"
  >
    <div class="flex flex-row max-w-7xl centered mx-auto gap-10 px-4 md:px-0">
      <div class="mx-auto px-4 md:w-2/3">
        <!-- Header -->
        <div class="max-w-3xl mb-20">
          <h2
            class="text-5xl md:text-6xl font-bold mb-6 text-gray-900 leading-tight"
          >
            Servicios que ofrecemos
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 leading-relaxed">
            Descubre todas las comodidades y servicios diseñados para hacer de
            tu estadía una experiencia inolvidable. En Finca la Sociedad
            encontrarás todo lo necesario para disfrutar al máximo.
          </p>
        </div>
      </div>
      <div class="md:w-1.5/4">
        <img
          src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800&q=80"
          alt="Vista principal de la finca"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 rounded-2xl"
        />
        <!-- <picture>
          <source
            srcset="/images/banner_principal_mobil.webp"
            media="(max-width: 768px)"
          />
          <img
            src="/images/banner_principal.webp"
            alt="Diseño con identidad arte que se vive"
            class="w-full h-auto object-cover"
            fetchpriority="high"
          />
        </picture> -->
      </div>
    </div>
  </section>

  <!-- Servicios Section -->
  <section
    class="py-24 bg-white flex flex-row centered mx-auto gap-10 px-4 md:px-0"
  >
    <div class="mx-auto max-w-7xl px-4">
      <!-- Services Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        <!-- Feature 1 - Capacidad -->
        <div class="group">
          <div
            class="bg-linear-to-br from-green-50 to-green-100 rounded-3xl p-8 h-full transition-all duration-300 hover:shadow-xl"
          >
            <div
              class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-green-600"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-900">Capacidad</h3>
            <p class="text-gray-600 text-lg leading-relaxed">
              Hasta 15 personas cómodamente alojadas
            </p>
          </div>
        </div>

        <!-- Feature 2 - Piscina -->
        <div class="group">
          <div
            class="bg-linear-to-br from-blue-50 to-blue-100 rounded-3xl p-8 h-full transition-all duration-300 hover:shadow-xl"
          >
            <div
              class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300"
            >
              <svg
                class="text-blue-600"
                fill="currentColor"
                width="auto"
                height="45"
                viewBox="0 0 55 55"
                xmlns="http://www.w3.org/2000/svg"
                version="1.1"
              >
                <path
                  d="M33.804 0.242c0.157 0.095 0.312 0.193 0.463 0.295l0.295 0.181c0.79 0.812 1.027 1.629 1.036 2.734C35.58 4.373 35.175 5.013 34.59 5.693a11.494 11.494 0 0 1 -0.629 0.472l-0.194 0.137c-1.013 0.705 -2.051 1.375 -3.084 2.05a1058.643 1058.643 0 0 0 -1.258 0.824l-0.286 0.186A26.211 26.211 0 0 0 27.5 10.527a362.119 362.119 0 0 0 2.513 3.386 194.971 194.971 0 0 1 1.348 1.818c0.532 0.724 1.072 1.442 1.618 2.155 0.864 1.129 1.707 2.273 2.547 3.42a191.855 191.855 0 0 0 2.398 3.203c0.544 0.712 1.078 1.43 1.607 2.152Q40.117 27.46 40.713 28.252a207.861 207.861 0 0 1 1.608 2.168c0.281 0.383 0.562 0.763 0.855 1.137l0.14 0.18a67.246 67.246 0 0 0 0.365 0.462L43.828 32.441l-0.107 0.322c-0.302 0.119 -0.302 0.119 -0.705 0.235 -1.424 0.444 -2.641 1.123 -3.833 2.017 -0.846 0.628 -1.611 0.764 -2.66 0.649 -0.6 -0.179 -1.073 -0.533 -1.57 -0.905 -2.612 -1.947 -5.882 -2.809 -9.116 -2.352 -2.285 0.378 -4.268 1.285 -6.105 2.69 -0.793 0.597 -1.577 0.674 -2.545 0.567 -0.719 -0.222 -1.303 -0.695 -1.909 -1.126C13.987 33.637 12.561 33.113 11.064 32.656c0.121 -0.362 0.174 -0.397 0.48 -0.595l0.242 -0.159 0.267 -0.171 0.279 -0.182q0.301 -0.196 0.602 -0.392c0.543 -0.352 1.085 -0.707 1.626 -1.061l0.338 -0.221c1.11 -0.727 2.21 -1.469 3.308 -2.213 1.794 -1.215 3.599 -2.413 5.411 -3.601A187.559 187.559 0 0 0 27.285 21.592q-0.151 -0.227 -0.302 -0.455l-0.17 -0.256c-0.275 -0.407 -0.566 -0.802 -0.858 -1.197l-0.194 -0.263c-0.57 -0.769 -1.151 -1.53 -1.733 -2.29a52.314 52.314 0 0 1 -1.269 -1.73c-0.411 -0.581 -0.847 -1.143 -1.282 -1.706C19.283 10.84 19.283 10.84 19.443 8.916c0.257 -1.066 0.879 -1.706 1.773 -2.283l0.241 -0.16c0.263 -0.174 0.527 -0.346 0.792 -0.518q0.422 -0.278 0.844 -0.556 0.295 -0.195 0.59 -0.389a210.439 210.439 0 0 0 2.16 -1.445l0.31 -0.21q0.6 -0.406 1.2 -0.814c0.934 -0.634 1.87 -1.265 2.825 -1.867l0.21 -0.133c1.022 -0.636 2.297 -0.847 3.415 -0.3"
                  fill="#5151ff"></path>
                <path
                  d="M12.684 46.724c2.074 1.445 4.538 1.952 7.036 1.55 1.431 -0.293 2.731 -1.034 3.913 -1.868 1.565 -1.061 3.063 -1.616 4.974 -1.347 1.249 0.253 2.215 0.821 3.231 1.561 0.779 0.565 1.513 0.979 2.43 1.289l0.385 0.133c2.323 0.694 4.782 0.409 6.902 -0.733 0.589 -0.333 1.15 -0.71 1.705 -1.097 1.472 -1.02 2.999 -1.405 4.796 -1.154 1.312 0.263 2.331 0.908 3.408 1.664 0.872 0.607 1.762 1.037 2.771 1.365l0.224 0.074q0.271 0.089 0.542 0.177c0.011 0.799 0.018 1.598 0.024 2.397q0.003 0.408 0.009 0.815c0.005 0.391 0.008 0.782 0.01 1.173l0.007 0.367c0 0.65 -0.01 1.089 -0.478 1.586 -0.459 0.352 -0.872 0.368 -1.43 0.363l-0.273 0.002c-0.303 0.001 -0.606 0 -0.909 -0.001q-0.328 0.001 -0.657 0.002c-0.603 0.002 -1.205 0.001 -1.808 0 -0.649 -0.001 -1.299 0.001 -1.948 0.002 -1.199 0.002 -2.398 0.002 -3.597 0.002a3309.238 3309.238 0 0 0 -4.44 0.001c-2.081 0.001 -4.162 0.002 -6.243 0.001l-0.238 0 -1.912 -0.001q-3.729 -0.002 -7.458 0.002a6562.939 6562.939 0 0 1 -9.269 0.003l-0.222 0q-1.661 0 -3.321 0.002 -1.888 0.002 -3.776 0c-0.643 -0.001 -1.285 -0.001 -1.928 0q-0.882 0.002 -1.763 -0.001 -0.319 -0.001 -0.639 0.001c-0.289 0.001 -0.578 0 -0.867 -0.002l-0.252 0.003C1.065 55.049 0.751 54.921 0.322 54.57c-0.291 -0.378 -0.362 -0.648 -0.359 -1.121v-0.345l0.005 -0.369 0.001 -0.381c0.002 -0.401 0.006 -0.801 0.01 -1.202q0.003 -0.408 0.005 -0.815 0.005 -0.999 0.016 -1.998l0.346 -0.104c1.555 -0.472 2.892 -1.103 4.211 -2.06 2.688 -1.939 5.59 -1.233 8.127 0.548"
                  fill="#5151ff"></path>
                <path
                  d="M14.047 37.316C15.592 38.411 17.025 38.827 18.906 38.672c1.158 -0.204 2.179 -0.772 3.095 -1.497 2.006 -1.556 4.511 -2.075 6.998 -1.783 1.636 0.29 3.035 0.966 4.383 1.924C34.928 38.411 36.361 38.827 38.242 38.672c1.158 -0.204 2.179 -0.772 3.095 -1.497 1.995 -1.535 4.549 -2.095 7.024 -1.783 1.909 0.293 3.453 1.197 5.013 2.295 0.363 0.252 0.733 0.488 1.109 0.718 0.33 0.271 0.499 0.565 0.555 0.989l-0.002 0.32 0 0.365 -0.005 0.39 -0.001 0.402q-0.002 0.527 -0.008 1.055c-0.003 0.359 -0.005 0.719 -0.006 1.078q-0.005 1.056 -0.016 2.112c-0.899 -0.311 -1.654 -0.663 -2.417 -1.229 -2.126 -1.51 -4.554 -2.204 -7.159 -1.804 -1.691 0.303 -3.088 1.046 -4.458 2.061 -1.471 1.089 -2.986 1.313 -4.765 1.186 -1.291 -0.221 -2.329 -0.924 -3.377 -1.672 -1.944 -1.375 -4.255 -1.885 -6.604 -1.609 -1.752 0.314 -3.174 1.045 -4.59 2.094 -1.471 1.089 -2.986 1.313 -4.765 1.186 -1.291 -0.221 -2.329 -0.924 -3.377 -1.672 -1.995 -1.411 -4.435 -1.946 -6.843 -1.576 -1.547 0.277 -2.851 0.919 -4.126 1.832C1.719 44.49 0.984 44.965 0 45.117a360.615 360.615 0 0 1 -0.024 -2.489q-0.003 -0.423 -0.009 -0.846c-0.005 -0.406 -0.008 -0.812 -0.01 -1.218l-0.007 -0.382C-0.049 39.504 -0.041 39.072 0.43 38.564c0.199 -0.17 0.199 -0.17 0.404 -0.295l0.229 -0.144 0.24 -0.145q0.249 -0.155 0.497 -0.31l0.24 -0.15c0.265 -0.169 0.516 -0.353 0.767 -0.541 3.475 -2.456 7.893 -2.043 11.24 0.336"
                  fill="#5151ff"></path>
                <path
                  d="M48.984 14.072c1.362 1.06 2.391 2.455 2.686 4.189 0.169 1.918 -0.086 3.672 -1.297 5.227 -1.222 1.412 -2.708 2.262 -4.571 2.48 -1.789 0.124 -3.535 -0.438 -4.888 -1.611 -1.213 -1.141 -2.096 -2.583 -2.171 -4.285 -0.033 -2.046 0.38 -3.699 1.826 -5.219 2.279 -2.222 5.758 -2.559 8.415 -0.782"
                  fill="#5151ff"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-900">Piscina</h3>
            <p class="text-gray-600 text-lg leading-relaxed">
              Piscina privada para tu máximo disfrute
            </p>
          </div>
        </div>

        <!-- Feature 3 - Zonas Verdes -->
        <div class="group">
          <div
            class="bg-linear-to-br from-emerald-50 to-emerald-100 rounded-3xl p-8 h-full transition-all duration-300 hover:shadow-xl"
          >
            <div
              class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-emerald-600"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                version="1.1"
                xmlns="http://www.w3.org/2000/svg"
                version="1.1"
                width="55"
                height="55"
                viewBox="0 0 55 55"
                ><path
