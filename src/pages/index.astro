              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-900">Zonas Verdes</h3>
            <p class="text-gray-600 text-lg leading-relaxed">
              Amplios espacios naturales al aire libre
            </p>
          </div>
        </div>

        <!-- Feature 4 - Parqueadero -->
        <div class="group">
          <div
            class="bg-linear-to-br from-slate-50 to-slate-100 rounded-3xl p-8 h-full transition-all duration-300 hover:shadow-xl"
          >
            <div
              class="w-20 h-20 bg-white rounded-full flex items-center justify-center mb-6 shadow-md group-hover:scale-105 transition-transform duration-300"
            >
              <svg
                class="w-10 h-10 text-slate-600"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
                ></path>
                <path
                  d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-3 text-gray-900">Parqueadero</h3>
            <p class="text-gray-600 text-lg leading-relaxed">
              Parqueo privado y totalmente seguro
            </p>
          </div>
        </div>

        <!-- Feature 5 - Privacidad -->
        <div class="group">
          <div
            class="bg-linear-to-br from-purple-50 to-purple-100 rounded-3xl p-8 h-full transition-all duration-300 hover:shadow-xl"
          >
            <div
