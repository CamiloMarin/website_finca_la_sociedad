        rgba(16, 185, 129, 0.9) 0%,
        rgba(5, 150, 105, 0.9) 100%
      );
    }

    /* Fuente inclinada para títulos */
    .skew-title {
      transform: skewX(-15deg);
      display: inline-block;
      padding: 0 8px;
    }

    /* Reset de skew para contenido dentro */
    .skew-title > * {
      transform: skewX(15deg);
      display: inline-block;
    }

    /* Transición suave para imágenes de fondo */
    .bg-transition {
      transition: background-image 0.6s ease-in-out;
    }

    /* Estilos para Swiper */
    .swiper-container {
      width: 100%;
      height: 100%;
    }

    .swiper-pagination-bullet {
      background-color: white;
      opacity: 0.5;
      width: 10px;
      height: 10px;
    }

    .swiper-pagination-bullet-active {
      opacity: 1;
      background-color: #d4af37;
    }

    .swiper-button-next:after,
    .swiper-button-prev:after {
      font-size: 24px;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"
  ></script>

  <script>
    // Smooth scroll para navegación
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        e.preventDefault();
        const href = anchor.getAttribute("href");
        const target = href ? document.querySelector(href) : null;

        if (target) {
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        }
      });
    });

    // Animación de fade-in al hacer scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const entryTarget = entry.target as HTMLElement;
          entryTarget.style.opacity = "1";
          entryTarget.style.transform = "translateY(0)";
        }
      });
    }, observerOptions);

    document.querySelectorAll("section").forEach((section) => {
      section.style.opacity = "0";
      section.style.transform = "translateY(20px)";
      section.style.transition = "opacity 0.6s ease, transform 0.6s ease";
      observer.observe(section);
    });
  </script>
